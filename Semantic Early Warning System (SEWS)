sklearn.metrics.pairwise import cosine_similarity\n\n# Helper: find most similar words by cosine similarity\ndef most_similar(word, topn=5):\n    if word not in embeddings_index:\n        return []\n    word_vec = embeddings_index[word].reshape(1, -1)\n    sims = cosine_similarity(word_vec, all_vectors)[0]\n    vocab = list(embeddings_index.keys())\n    # Get top-n excluding the word itself\n    top_indices = sims.argsort()[-topn-1:][::-1]\n    return [(vocab[i], sims[i]) for i in top_indices if vocab[i] != word][:topn]\n\n# Try out some example queries\nfor w in [\"love\", \"hate\", \"virus\", \"freedom\"]:\n    print(f\"\\nTop similar to '{w}':\")\n    for sim_word, score in most_similar(w, topn=5):\n        print(f\"   {sim_word:15s} (cosine sim: {score:.3f})\")\n        ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-09-08T12:25:42.018243Z","iopub.execute_input":"2025-09-08T12:25:42.019037Z","iopub.status.idle":"2025-09-08T12:25:44.042187Z","shell.execute_reply.started":"2025-09-08T12:25:42.019013Z","shell.execute_reply":"2025-09-08T12:25:44.041531Z"}},"outputs":[{"name":"stdout","text":"\nTop similar to 'love':\n   you             (cosine sim: 0.880)\n   much            (cosine sim: 0.838)\n   and             (cosine sim: 0.811)\n   my              (cosine sim: 0.809)\n   loves           (cosine sim: 0.801)\n\nTop similar to 'hate':\n   people          (cosine sim: 0.838)\n   n't             (cosine sim: 0.835)\n   stupid          (cosine sim: 0.834)\n   why             (cosine sim: 0.826)\n   fuck            (cosine sim: 0.822)\n\nTop similar to 'virus':\n   malware         (cosine sim: 0.688)\n   hepatitis       (cosine sim: 0.647)\n   influenza       (cosine sim: 0.631)\n   flu             (cosine sim: 0.610)\n   anti            (cosine sim: 0.609)\n\nTop similar to 'freedom':\n   democracy       (cosine sim: 0.761)\n   liberty         (cosine sim: 0.720)\n   peace           (cosine sim: 0.718)\n   rights          (cosine sim: 0.713)\n   independence    (cosine sim: 0.707)\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# Visualize Word Embeddings with PCA + t-SNE\n\nfrom sklearn.decomposition import PCA\nfrom sklearn.manifold import TSNE\nimport random\n\n# Select a subset of words for visualization\nsample_size = 2000\nsample_words = random.sample(list(embeddings_index.keys()), sample_size)\nsample_vectors = np.array([embeddings_index[w] for w in sample_words])\n\n# Step 1: Reduce dimensions with PCA for efficiency\npca = PCA(n_components=50)\nsample_pca = pca.fit_transform(sample_vectors)\n\n# Step 2: Apply t-SNE to project into 2D\ntsne = TSNE(n_components=2, perplexity=40, n_iter=1000, random_state=SEED, verbose=1)\nsample_tsne = tsne.fit_transform(sample_pca)\n\n# Step 3: Plot the embedding clusters\nplt.figure(figsize=(14, 10))\nplt.scatter(sample_tsne[:, 0], sample_tsne[:, 1], s=10, alpha=0.7)\n\n# Annotate a few points for clarity\nfor i, word in enumerate(sample_words[:50]):  # label only first 50 to avoid clutter\n    plt.annotate(word, (sample_tsne[i, 0], sample_tsne[i, 1]), fontsize=8, alpha=0.75)\n\nplt.title(\"t-SNE Projection of Twitter GloVe Embeddings\", fontsize=16)\nplt.xlabel(\"Dimension 1\")\nplt.ylabel(\"Dimension 2\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-09-08T12:26:31.473777Z","iopub.execute_input":"2025-09-08T12:26:31.474492Z","iopub.status.idle":"2025-09-08T12:26:43.131649Z","shell.execute_reply.started":"2025-09-08T12:26:31.474469Z","shell.execute_reply":"2025-09-08T12:26:43.130822Z"}},"outputs":[{"name":"stdout","text":"[t-SNE] Computing 121 nearest neighbors...\n[t-SNE] Indexed 2000 samples in 0.000s...\n[t-SNE] Computed neighbors for 2000 samples in 0.171s...\n[t-SNE] Computed conditional probabilities for sample 1000 / 2000\n[t-SNE] Computed conditional probabilities for sample 2000 / 2000\n[t-SNE] Mean sigma: 1.247840\n[t-SNE] KL divergence after 250 iterations with early exaggeration: 70.4533